<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Artemis.Plugins.Devices.OpenRGB.Views.OpenRGBConfigurationDialogView">
    <Grid RowDefinitions="Auto,Auto,300,Auto,Auto,*">
        <StackPanel Grid.Row="0" Classes="plugin-introduction">
            <TextBlock TextWrapping="Wrap">
                Configure the OpenRGB SDK servers Artemis connects to.
                <LineBreak />
                Changes are applied when you save. Changing servers or device options reloads all OpenRGB devices.
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="1" Classes="card-title">Servers</TextBlock>
        <Border Grid.Row="2" Classes="card" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Definitions}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*"
                                        Binding="{Binding ClientName}"
                                        Header="Client Name" />
                    <DataGridTextColumn Width="Auto"
                                        Binding="{Binding Ip}"
                                        Header="IP Address" />
                    <DataGridTextColumn Width="Auto"
                                        Binding="{Binding Port}"
                                        Header="Port" />
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding $parent[UserControl].DataContext.DeleteDefinition}"
                                        CommandParameter="{Binding}"
                                        Classes="icon-button"
                                        ToolTip.Tip="Delete server configuration"
                                        HorizontalAlignment="Center">
                                    <avalonia:MaterialIcon Kind="Delete" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Classes="card-title">Advanced</TextBlock>
        <Border Grid.Row="4" Classes="card">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock>
                        Force using devices with no direct mode
                    </TextBlock>
                    <TextBlock Classes="subtitle" TextWrapping="Wrap">
                        If enabled, all OpenRGB devices are added, even those without a Direct mode.
                    </TextBlock>
                    <TextBlock Foreground="GoldenRod">
                        This can cause hardware damage to some devices - use with caution &amp; at your own risk!
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                    <ToggleSwitch IsChecked="{Binding ForceAddAllDevices}" MinWidth="0" />
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="card-separator" />

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock>
                        Rescan devices on startup, wake and unlock
                    </TextBlock>
                    <TextBlock Classes="subtitle" TextWrapping="Wrap">
                        Rescan for OpenRGB devices and reload them on startup, unlock or resume.
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                    <ToggleSwitch IsChecked="{Binding RescanOnResume}" MinWidth="0" />
                </StackPanel>

                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Classes="card-separator" />

                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock>
                        Warm-up period before rescanning
                    </TextBlock>
                    <TextBlock Classes="subtitle" TextWrapping="Wrap">
                        How long to wait after waking up or unlocking before asking OpenRGB to rescan, giving devices time to come back. 0 rescans immediately.
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <controls:NumberBox Value="{Binding RescanDelay}"
                                        IsEnabled="{Binding RescanOnResume}"
                                        Minimum="0"
                                        Maximum="600"
                                        SimpleNumberFormat="F0"
                                        Width="120" />
                    <TextBlock VerticalAlignment="Center" TextAlignment="Right" Width="30">sec</TextBlock>
                </StackPanel>

                <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Classes="card-separator" />

                <StackPanel Grid.Row="6" Grid.Column="0">
                    <TextBlock>
                        Reload when OpenRGB's device list changes
                    </TextBlock>
                    <TextBlock Classes="subtitle" TextWrapping="Wrap">
                        Automatically reloads OpenRGB devices when devices are added or removed.
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="6" Grid.Column="1" VerticalAlignment="Center">
                    <ToggleSwitch IsChecked="{Binding ReloadOnDeviceListChange}" MinWidth="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal">
                <Button Margin="0 0 5 0" Command="{Binding AddDefinition}">
                    Add server
                </Button>
                <Button Command="{Binding RescanDevices}" ToolTip.Tip="Ask OpenRGB to rescan its devices, then reload them in Artemis">
                    Rescan devices
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Classes="accent" Margin="0 0 5 0" Command="{Binding SaveChanges}">
                    Save changes
                </Button>
                <Button Command="{Binding Cancel}">
                    Cancel
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>